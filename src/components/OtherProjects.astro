---
import type { OtherProject } from "../data/portfolio";
import OtherProjectItem from "./OtherProjectItem.astro";

interface Props {
	projects: OtherProject[];
}

const { projects } = Astro.props;
---

<section class="other-projects container" id="other-projects">
	<h2 class="section-title"><span class="mark">##</span> other projects</h2>
	<p class="comment">// more things I've built and contributed to</p>
	<div class="other-projects__list">
		{projects.map((project) => (
			<OtherProjectItem
				name={project.name}
				tags={project.tags}
				description={project.description}
				details={project.details}
				githubUrl={project.githubUrl}
				liveUrl={project.liveUrl}
			/>
		))}
	</div>
</section>

<style>
	.other-projects__list {
		margin-top: 2rem;
	}
</style>
