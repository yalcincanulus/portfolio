---
import TagBadge from "./TagBadge.astro";

interface Props {
	name: string;
	tags: string[];
	description: string;
	details: string[];
	githubUrl?: string;
	liveUrl?: string;
}

const { name, tags, description, details, githubUrl, liveUrl } = Astro.props;
---

<details class="other-project toggle">
	<summary>
		<span class="other-project__name">{name}</span>
		<span class="other-project__tags">{tags.map((tag) => <TagBadge label={tag} />)}</span>
	</summary>
	<div class="other-project__content">
		<p class="other-project__description">{description}</p>
		{details.length > 0 && (
			<ul class="dash-list">
				{details.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		)}
		{(githubUrl || liveUrl) && (
			<div class="other-project__links">
				{liveUrl && <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="link">live demo</a>}
				{githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="link">source</a>}
			</div>
		)}
	</div>
</details>

<style>
	.other-project:not(:last-child) {
		margin-bottom: 1.5rem;
	}

	.other-project__name {
		color: var(--text);
		font-weight: 500;
	}

	.other-project__tags {
		display: block;
		margin-top: 0.25rem;
		padding-left: 1.25em;
		font-size: 0.8125rem;
		color: var(--text-faint);
	}

	.other-project__content {
		padding-left: 1.25em;
	}

	.other-project__description {
		margin-top: 0.75rem;
		color: var(--text-muted);
	}

	.other-project__links {
		display: flex;
		gap: 1.25rem;
		margin-top: 0.75rem;
	}
</style>
