---
interface Props {
	resumePath: string;
}

const { resumePath } = Astro.props;
const isAboutPage = Astro.url.pathname === "/about";
---

<header class="header">
	<nav class="header__nav container">
		<a href="/" class="header__logo" id="header-logo">~/ulus.uk</a>
		<div class="header__actions">
			<a
				href="/about"
				class:list={["header__link", isAboutPage && "header__link--active"]}
				aria-current={isAboutPage ? "page" : undefined}
				data-track="about-click"
			>
				about
			</a>
			<a href={resumePath} target="_blank" rel="noopener noreferrer" class="header__link" aria-label="Resume/CV (PDF, opens in a new tab)" data-track="resume-click">
				resume/CV (pdf)
				<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: var(--bg);
		border-bottom: 1px dashed var(--border);
	}

	.header__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		padding-block: 1rem;
	}

	.header__logo,
	.header__link {
		color: var(--text-faint);
		transition: color 0.2s ease;
	}

	.header__actions {
		display: flex;
		gap: 1.25rem;
	}

	.header__link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--accent);
		white-space: nowrap;
	}

	.header__logo:hover,
	.header__link--active {
		color: var(--text);
	}

	.header__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}
</style>

<script>
	if (!document.documentElement.dataset.headerLogoBound) {
		document.addEventListener("click", (clickEvent) => {
			const target = clickEvent.target;

			if (!(target instanceof Element)) {
				return;
			}

			const logo = target.closest("#header-logo");

			if (!logo || window.location.pathname !== "/") {
				return;
			}

			clickEvent.preventDefault();
			window.scrollTo({ top: 0, behavior: "smooth" });
		});

		document.documentElement.dataset.headerLogoBound = "true";
	}
</script>
