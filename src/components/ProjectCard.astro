---
import ImageCarousel from "./ImageCarousel.astro";
import TagBadge from "./TagBadge.astro";

interface Props {
	number: number;
	name: string;
	tags: string[];
	description: string;
	details: string[];
	images: ImageMetadata[];
	githubUrl: string;
	liveUrl?: string;
	aboveFold?: boolean;
}

const {
	number,
	name,
	tags,
	description,
	details,
	images,
	githubUrl,
	liveUrl,
	aboveFold = false,
} = Astro.props;

const arrowIcon = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>`;
---

<article class="project">
	<h3 class="project__name"><span class="mark">{String(number).padStart(2, "0")}</span> {name}</h3>
	<p class="project__description">{description}</p>

	<dl class="project__meta">
		<dt>stack</dt>
		<dd>{tags.map((tag) => <TagBadge label={tag} />)}</dd>
		<dt>links</dt>
		<dd class="project__links">
			{liveUrl && (
				<a href={liveUrl} target="_blank" rel="noopener noreferrer" class="link" data-track="live-demo-click" data-project={name}>
					live demo
					<Fragment set:html={arrowIcon} />
				</a>
			)}
			<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="link" data-track="github-click" data-project={name}>
				source
				<Fragment set:html={arrowIcon} />
			</a>
		</dd>
	</dl>

	<ImageCarousel images={images} projectName={name} aboveFold={aboveFold} />

	{details.length > 0 && (
		<details class="toggle">
			<summary>show details ({details.length})</summary>
			<ul class="dash-list">
				{details.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</details>
	)}
</article>

<style>
	.project {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.project:not(:last-child) {
		margin-bottom: 4rem;
	}

	.project__name {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.5;
	}

	.project__description {
		color: var(--text-muted);
	}

	.project__meta {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 0.25rem 1rem;
		font-size: 0.8125rem;
	}

	.project__meta dt {
		color: var(--text-faint);
	}

	.project__meta dd {
		color: var(--text-muted);
	}

	.project__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	@media (max-width: 480px) {
		.project__meta {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.project__meta dd:not(:last-child) {
			margin-bottom: 0.5rem;
		}
	}
</style>
