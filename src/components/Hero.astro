---
import ContactLinks from "./ContactLinks.astro";

interface Props {
	name: string;
	description: string;
	email: string;
	githubUrl: string;
	linkedinUrl: string;
	resumePath: string;
}

const { name, description, ...contact } = Astro.props;
---

<section class="hero container" id="hero">
	<h1 class="hero__name"><span class="mark">#</span> {name}</h1>
	<p class="hero__description">&gt; {description}.</p>
	<div class="hero__links">
		<ContactLinks {...contact} />
	</div>
</section>

<style>
	.hero {
		padding-block: 6rem 3rem;
	}

	.hero__name {
		font-size: 1.75rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.hero__description {
		margin-top: 1rem;
		color: var(--text-muted);
	}

	.hero__links {
		margin-top: 1.5rem;
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 4rem;
		}
	}
</style>
