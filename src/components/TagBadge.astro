---
interface Props {
	label: string;
}

const { label } = Astro.props;
// The trailing space after the tag gives long stack lists a place to wrap.
---

<span class="tag">{label}</span>{" "}

<style>
	.tag:not(:last-of-type)::after {
		content: "·";
		margin-left: 0.5em;
		color: var(--text-faint);
	}
</style>
