---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<span class="tag">{label}</span>

<style>
	.tag {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		white-space: nowrap;
		line-height: 1.6;
	}

	.tag:not(:last-child)::after {
		content: "/";
		margin-inline: 0.5rem;
		color: var(--text-faint);
		opacity: 0.6;
	}
</style>
