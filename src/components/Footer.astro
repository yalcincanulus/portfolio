---
import ContactLinks from "./ContactLinks.astro";

interface Props {
	email: string;
	githubUrl: string;
	linkedinUrl: string;
	resumePath: string;
	name: string;
}

const { name, ...contact } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer container">
	<hr class="divider" />
	<div class="footer__inner">
		<h2 class="section-title"><span class="mark">##</span> contact</h2>
		<ContactLinks {...contact} />
		<p class="footer__copy">&copy; {currentYear} {name}</p>
	</div>
</footer>

<style>
	.footer {
		padding-bottom: 3rem;
	}

	.footer__inner {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 3rem;
	}

	.footer__copy {
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		color: var(--text-faint);
	}
</style>
