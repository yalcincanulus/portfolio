---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import OtherProjects from "../components/OtherProjects.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { otherProjects, projects, siteData } from "../data/portfolio";
import Layout from "../layouts/Layout.astro";

const screenshotModules = import.meta.glob(
	"../assets/projects/*/*.{png,jpg,jpeg,webp,avif}",
	{ eager: true, import: "default" },
) as Record<string, ImageMetadata>;

const projectImages = Object.entries(screenshotModules).reduce<
	Record<string, ImageMetadata[]>
>((imagesByProject, [path, image]) => {
	const segments = path.split("/");
	const projectId = segments.at(-2);

	if (!projectId) {
		return imagesByProject;
	}

	imagesByProject[projectId] ??= [];
	imagesByProject[projectId].push(image);
	imagesByProject[projectId].sort((left, right) =>
		left.src.localeCompare(right.src),
	);

	return imagesByProject;
}, {});
---

<Layout title={siteData.title} description={siteData.description}>
	<Header name={siteData.name} resumePath={siteData.resumePath} />

	<main>
		<Hero
			name={siteData.name}
			description={siteData.description}
			email={siteData.email}
			githubUrl={siteData.githubUrl}
		/>

		<section class="projects section" id="projects">
			<div class="container">
				<header class="projects__header">
					<h2 class="section-title">Selected work</h2>
					<p class="projects__subtitle">One-click <strong>guest logins</strong> available for quick testing (where applicable).</p>
				</header>
				<div class="projects__grid">
					{projects.map((project, i) => (
						<ProjectCard
							name={project.name}
							tags={project.tags}
							description={project.description}
							details={project.details}
							images={projectImages[project.id] ?? []}
							githubUrl={project.githubUrl}
							liveUrl={project.liveUrl}
							aboveFold={i === 0}
						/>
					))}
				</div>
			</div>
		</section>

		<OtherProjects projects={otherProjects} />
	</main>

	<Footer
		email={siteData.email}
		githubUrl={siteData.githubUrl}
		linkedinUrl={siteData.linkedinUrl}
		resumePath={siteData.resumePath}
		name={siteData.name}
	/>
</Layout>

<style>
	.projects__subtitle {
		margin-top: 0.75rem;
		color: var(--text-muted);
		font-size: 0.9375rem;
	}

	.projects__subtitle strong {
		color: var(--text);
		font-weight: 500;
	}

	.projects__grid {
		display: flex;
		flex-direction: column;
		margin-top: 4rem;
	}
</style>
