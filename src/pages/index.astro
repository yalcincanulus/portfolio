---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import OtherProjects from "../components/OtherProjects.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { otherProjects, projects, siteData } from "../data/portfolio";
import Layout from "../layouts/Layout.astro";

const screenshotModules = import.meta.glob(
	"../assets/projects/*/*.{png,jpg,jpeg,webp,avif}",
	{ eager: true, import: "default" },
) as Record<string, ImageMetadata>;

const projectImages = Object.entries(screenshotModules).reduce<
	Record<string, ImageMetadata[]>
>((imagesByProject, [path, image]) => {
	const segments = path.split("/");
	const projectId = segments.at(-2);

	if (!projectId) {
		return imagesByProject;
	}

	imagesByProject[projectId] ??= [];
	imagesByProject[projectId].push(image);
	imagesByProject[projectId].sort((left, right) =>
		left.src.localeCompare(right.src),
	);

	return imagesByProject;
}, {});

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	mainEntity: {
		"@type": "Person",
		name: siteData.name,
		alternateName: "Yalcincan Ulus",
		url: Astro.site?.href,
		jobTitle: "Full-Stack Engineer",
		description: siteData.description,
		address: { "@type": "PostalAddress", addressCountry: "TR" },
		alumniOf: [
			{ "@type": "CollegeOrUniversity", name: "Istanbul Technical University" },
			{ "@type": "CollegeOrUniversity", name: "Sakarya University" },
		],
		knowsLanguage: ["Turkish", "English"],
		knowsAbout: [
			"TypeScript",
			"React",
			"Node.js",
			"Bun",
			"PostgreSQL",
			"Full-stack web development",
		],
		sameAs: [siteData.githubUrl, siteData.linkedinUrl],
	},
};
---

<Layout title={siteData.title} description={siteData.description}>
	<script
		slot="head"
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(personJsonLd)}
	/>
	<Header resumePath={siteData.resumePath} />

	<main>
		<Hero
			name={siteData.name}
			description={siteData.description}
			email={siteData.email}
			githubUrl={siteData.githubUrl}
			linkedinUrl={siteData.linkedinUrl}
			resumePath={siteData.resumePath}
		/>

		<div class="container"><hr class="divider" /></div>

		<section class="projects container" id="projects">
			<h2 class="section-title"><span class="mark">##</span> selected work</h2>
			<p class="comment">// one-click guest logins available where applicable</p>
			<div class="projects__list">
				{projects.map((project, i) => (
					<ProjectCard
						number={i + 1}
						name={project.name}
						tags={project.tags}
						description={project.description}
						details={project.details}
						images={projectImages[project.id] ?? []}
						githubUrl={project.githubUrl}
						liveUrl={project.liveUrl}
						aboveFold={i === 0}
					/>
				))}
			</div>
		</section>

		<div class="container"><hr class="divider" /></div>

		<OtherProjects projects={otherProjects} />
	</main>

	<Footer
		email={siteData.email}
		githubUrl={siteData.githubUrl}
		linkedinUrl={siteData.linkedinUrl}
		resumePath={siteData.resumePath}
		name={siteData.name}
	/>
</Layout>

<style>
	main .divider {
		margin-block: 3rem;
	}

	.projects__list {
		margin-top: 3.5rem;
	}

	#other-projects {
		margin-bottom: 4rem;
	}
</style>
