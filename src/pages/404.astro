---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteData } from "../data/portfolio";
import Layout from "../layouts/Layout.astro";
---

<Layout title={`404 | ${siteData.title}`} description="Page not found.">
	<Header resumePath={siteData.resumePath} />

	<main class="not-found">
		<div class="container not-found__inner">
			<p class="comment">// error 404</p>
			<h1 class="not-found__title"><span class="mark">#</span> page not found</h1>
			<p class="not-found__message">
				&gt; The page you're looking for doesn't exist or has been moved.
			</p>
			<p>[<a href="/" class="link">go home</a>]</p>
		</div>
	</main>

	<Footer
		email={siteData.email}
		githubUrl={siteData.githubUrl}
		linkedinUrl={siteData.linkedinUrl}
		resumePath={siteData.resumePath}
		name={siteData.name}
	/>
</Layout>

<style>
	.not-found {
		padding-block: 8rem;
	}

	.not-found__inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.not-found__title {
		font-size: 1.75rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.not-found__message {
		color: var(--text-muted);
	}
</style>
